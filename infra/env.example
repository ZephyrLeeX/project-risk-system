# 生产部署环境变量模板（T035）。
# 复制为 .env.production（已被 gitignore），填写真实值后执行：
#   docker compose --env-file .env.production -f infra/docker-compose.yml up -d
#
# 以下所有值均为占位符，绝不可提交真实密钥。会话密钥通过
# infra/scripts/init-secrets.sh 生成，TLS 证书通过 openssl 生成；详见
# infra/README.md。

# --- 运行时 / 边缘入口 ---
NODE_ENV=production
# 浏览器访问应用时使用的公开 Origin（反向代理 TLS 端口）。
CORS_ORIGIN=https://risk.example.internal:8443
# 请求来源校验默认开启。仅在受控测试或排障环境中才可显式设为 false；正式生产必须保持 true。
REQUEST_ORIGIN_VALIDATION_ENABLED=true
# HTTPS 反向代理的宿主机端口。
PROXY_HTTPS_PORT=8443
# 单台服务器上的 Celery worker 并发数。
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=900
LOG_LEVEL=info
SESSION_COOKIE_NAME=project_risk_session

# --- WeChat mini-program SSO (optional; API only) ---
# Configure the environment-specific HTTPS endpoint in .env.production.
WECHAT_USER_INFO_URL=
WECHAT_USER_INFO_TIMEOUT_SECONDS=5
WECHAT_USER_INFO_MAX_RETRIES=2

# --- PostgreSQL（16） ---
POSTGRES_DB=project_risk
POSTGRES_USER=project_risk
# URL 安全（base64url）密码；由 init-secrets.sh 生成，必填。
POSTGRES_PASSWORD=replace_with_url_safe_password
# 可选，仅供本地开发 / 运维 psql 使用的 localhost 宿主机绑定。生产环境保持未设置：
# 服务仅通过 compose 网络访问 postgres，且不暴露宿主机 5432，因此宿主机进程使用
# 5432 不会阻塞部署。仅在 COMPOSE_FILE 同时包含 infra/docker-compose.host-postgres.yml
# 时（见 `pnpm db:up`）设置宿主机端口（如 5432）才生效；它独立于固定的容器内 5432，
# 不会复用 POSTGRES_PORT。
#POSTGRES_HOST_PORT=5432

# --- 密钥（注入使用，绝不提交） ---
# 静态字段加密所需的 32 字节 base64 密钥，必填；生成方式：
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# 会话签名密钥以只读 compose secret 挂载至
# /run/secrets/project_risk_session_key（由 init-secrets.sh 生成）；无需在此设置环境变量。

# 私有 AI Provider 地址必须同时精确匹配 hostname 与 CIDR。
# 留空时保留公共 HTTPS 访问，并拒绝私网目标。
AI_OUTBOUND_ALLOWED_HOSTNAMES=token.longshine.com
AI_OUTBOUND_ALLOWED_CIDRS=10.0.0.0/8

# --- Scheduler 节奏（ADR 0030 的运行默认值，并非 SLO） ---
SCHEDULER_OUTBOX_DRAIN_INTERVAL_SECONDS=5
SCHEDULER_RECONCILE_INTERVAL_SECONDS=30
SCHEDULER_MAILBOX_SYNC_INTERVAL_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=1
SCHEDULER_LOG_LEVEL=INFO

# --- 初始管理员（仅在首次初始化时由 `risk-platform-seed` 使用） ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=replace_with_strong_password
