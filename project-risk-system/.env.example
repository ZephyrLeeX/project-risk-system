NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:3000

POSTGRES_DB=project_risk
POSTGRES_USER=project_risk
POSTGRES_PASSWORD=change_me_for_local_development
# Optional host bind so the compose postgres is reachable from the host for
# local dev / integration tests (`pnpm db:up` pulls in the
# infra/docker-compose.host-postgres.yml override that consumes this). Leave
# UNSET for the deployment stack — it publishes no host 5432 and DATABASE_URL's
# localhost:5432 below is only reachable while this is set to 5432.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://project_risk:change_me_for_local_development@localhost:5432/project_risk?schema=public
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=900

SESSION_SECRET_FILE=/run/secrets/project_risk_session_key
SESSION_COOKIE_NAME=project_risk_session
SESSION_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30
PASSWORD_MIN_LENGTH=12
DATA_ENCRYPTION_KEY=replace_with_32_byte_base64_key
CORS_ORIGIN=http://localhost:5173
TRUSTED_PROXY_CIDRS=
# Private AI Providers require both an exact hostname and CIDR match.
AI_OUTBOUND_ALLOWED_HOSTNAMES=token.longshine.com
AI_OUTBOUND_ALLOWED_CIDRS=10.0.0.0/8
LOG_LEVEL=info
IMPORT_STORAGE_DIR=storage/excel

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=ChangeMe_2026!
