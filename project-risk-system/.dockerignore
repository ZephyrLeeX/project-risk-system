# Root .dockerignore — scopes the frontend (web) build context, whose context
# is the monorepo root. Keeps Docker from sending heavy/local-only trees.
**/.git
**/.venv
**/node_modules
**/dist
**/coverage
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/__pycache__
**/*.pyc
**/.env
**/.env.*
!**/.env.example
storage/**
legacy-prototype/**
ui-prototype/**
docs/**
tools/**
apps/api/**
apps/api-python/**
**/*.log
