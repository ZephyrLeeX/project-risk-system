generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum DataScopeType {
  ALL
  OWNED
  ASSIGNED
  OWNED_OR_ASSIGNED
  NONE
}

enum ProjectStatus {
  DELIVERY
  COMPLETED
  ARCHIVED
}

enum ProjectScopeSource {
  ADMIN
  IMPORT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum ProjectRiskLevel {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum ImportBatchStatus {
  PREVIEWED
  IMPORTED
  ROLLED_BACK
  FAILED
}

enum ImportRowStatus {
  READY
  WARNING
  ERROR
  IMPORTED
  ROLLED_BACK
}

enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
}

enum SupplementalMatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

enum LegalMatterMatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

enum RiskStatus {
  ACTIVE
  RESOLVED
}

enum RiskSourceType {
  EXCEL
  LITIGATION
  MAIL_AI
  MANUAL
}

enum ActionItemUrgency {
  EMERGENCY
  HIGH
  NORMAL
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ActionItemSourceType {
  RISK_SUGGESTION
  MANUAL
}

enum RiskTimelineEventType {
  RISK_CREATED
  RISK_UPDATED
  LEVEL_CHANGED
  ACTION_CREATED
  ACTION_UPDATED
  ACTION_STATUS_CHANGED
  ACTION_COMPLETED
  RISK_RESOLVED
  RISK_REOPENED
}

enum AiConnectionStatus {
  UNTESTED
  HEALTHY
  FAILED
}

enum AiCallResult {
  SUCCESS
  FAILURE
}

enum AiCallScene {
  WEEKLY_REPORT
  AGENT_QUERY
  RISK_EXTRACTION
  CONNECTION_TEST
}

enum MailboxProvider {
  QQ
  IMAP
}

enum MailboxEncryption {
  SSL
  STARTTLS
}

enum MailboxConnectionStatus {
  UNTESTED
  HEALTHY
  FAILED
}

enum MailSyncTrigger {
  MANUAL
  SCHEDULED
  RETRY
}

enum MailSyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILURE
}

enum MailMessageStatus {
  ANALYZING
  COMPLETED
  SKIPPED
  FAILED
}

enum MailMessageSkipReason {
  DUPLICATE
  RULE_MISMATCH
}

enum MailProjectMatchType {
  EXACT
  ALIAS
  FUZZY
  MANUAL
}

enum MailRiskCandidateStatus {
  PENDING
  CONFIRMED
  IGNORED
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(128)
  parentId  String?      @db.Uuid
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  enabled   Boolean      @default(true)
  sortOrder Int          @default(0)
  users     User[]
  projects  Project[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([parentId])
  @@map("departments")
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  username                String                    @unique @db.VarChar(64)
  passwordHash            String                    @db.VarChar(255)
  displayName             String                    @db.VarChar(128)
  email                   String?                   @db.VarChar(255)
  status                  UserStatus                @default(ACTIVE)
  mustChangePassword      Boolean                   @default(true)
  failedLoginCount        Int                       @default(0)
  lockedUntil             DateTime?                 @db.Timestamptz(3)
  departmentId            String?                   @db.Uuid
  department              Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                   UserRole[]
  projectScopes           UserProjectScope[]        @relation("ScopedUser")
  grantedProjectScopes    UserProjectScope[]        @relation("ScopeGrantedBy")
  managedProjects         Project[]                 @relation("ProjectManager")
  sessions                Session[]
  auditEvents             AuditLog[]                @relation("AuditActor")
  uploadedImportBatches   ImportBatch[]             @relation("ImportUploadedBy")
  confirmedImportBatches  ImportBatch[]             @relation("ImportConfirmedBy")
  rolledBackImportBatches ImportBatch[]             @relation("ImportRolledBackBy")
  reportedRisks           Risk[]                    @relation("RiskReporter")
  resolvedRisks           Risk[]                    @relation("RiskResolver")
  assignedActionItems     ActionItem[]              @relation("ActionAssignee")
  createdActionItems      ActionItem[]              @relation("ActionCreator")
  completedActionItems    ActionItem[]              @relation("ActionCompleter")
  riskTimelineEvents      RiskTimelineEvent[]       @relation("RiskTimelineActor")
  createdAiProviders      AiProviderConfig[]        @relation("AiProviderCreatedBy")
  updatedAiProviders      AiProviderConfig[]        @relation("AiProviderUpdatedBy")
  aiCallLogs              AiCallLog[]               @relation("AiCallActor")
  publishedSystemConfigs  SystemConfigRelease[]     @relation("SystemConfigPublisher")
  mailboxConfig           MailboxConfig?
  triggeredMailSyncs      MailSyncBatch[]           @relation("MailSyncOperator")
  confirmedMailMatches    MailMessageProjectMatch[] @relation("MailMatchConfirmer")
  reviewedMailRisks       MailRiskCandidate[]       @relation("MailRiskReviewer")
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  passwordChangedAt       DateTime?                 @db.Timestamptz(3)
  lastLoginAt             DateTime?                 @db.Timestamptz(3)

  @@index([departmentId])
  @@index([status])
  @@map("users")
}

model Role {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique @db.VarChar(64)
  name             String           @db.VarChar(128)
  description      String?          @db.VarChar(500)
  isSystem         Boolean          @default(false)
  enabled          Boolean          @default(true)
  defaultDataScope DataScopeType    @default(ASSIGNED)
  users            UserRole[]
  permissions      RolePermission[]
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([enabled])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(128)
  name        String           @db.VarChar(128)
  module      String           @db.VarChar(64)
  description String?          @db.VarChar(500)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String        @db.Uuid
  roleId     String        @db.Uuid
  dataScope  DataScopeType
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedAt DateTime      @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Project {
  id                         String                      @id @default(uuid()) @db.Uuid
  externalCode               String?                     @db.VarChar(128)
  importKey                  String?                     @unique @db.VarChar(64)
  name                       String                      @db.VarChar(255)
  alias                      String?                     @db.VarChar(255)
  status                     ProjectStatus               @default(DELIVERY)
  departmentId               String?                     @db.Uuid
  department                 Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId                  String?                     @db.Uuid
  manager                    User?                       @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  deliveryOwnerName          String?                     @db.VarChar(128)
  annualPlanAmount           Decimal?                    @db.Decimal(18, 2)
  actualCollectedAmount      Decimal?                    @db.Decimal(18, 2)
  remainingAmount            Decimal?                    @db.Decimal(18, 2)
  monthlyCollections         Json?
  monthAttributes            Json?
  collectionRiskLevel        ProjectRiskLevel            @default(UNKNOWN)
  collectionProgress         String?                     @db.Text
  lastImportedAt             DateTime?                   @db.Timestamptz(3)
  userScopes                 UserProjectScope[]
  matchedImportRows          ProjectImportRow[]          @relation("MatchedImportProject")
  committedImportRows        ProjectImportRow[]          @relation("CommittedImportProject")
  supplementalCollectionRows SupplementalCollectionRow[]
  legalMatterRows            LegalMatterRow[]
  risks                      Risk[]
  actionItems                ActionItem[]
  riskTimelineEvents         RiskTimelineEvent[]
  aliases                    ProjectAlias[]
  mailMatches                MailMessageProjectMatch[]
  mailRiskCandidates         MailRiskCandidate[]
  sourceVersion              Int                         @default(1)
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)

  @@unique([externalCode])
  @@index([name])
  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

model ImportBatch {
  id                        String                      @id @default(uuid()) @db.Uuid
  fileName                  String                      @db.VarChar(255)
  fileHash                  String                      @db.VarChar(64)
  storageKey                String                      @db.VarChar(500)
  status                    ImportBatchStatus           @default(PREVIEWED)
  sheetName                 String                      @db.VarChar(128)
  sourceMeta                Json?
  totalRows                 Int
  readyRows                 Int
  warningRows               Int
  errorRows                 Int
  createdRows               Int                         @default(0)
  updatedRows               Int                         @default(0)
  supplementalTotalRows     Int                         @default(0)
  supplementalMatchedRows   Int                         @default(0)
  supplementalUnmatchedRows Int                         @default(0)
  supplementalAmbiguousRows Int                         @default(0)
  supplementalWarningRows   Int                         @default(0)
  supplementalErrorRows     Int                         @default(0)
  legalTotalRows            Int                         @default(0)
  legalMatchedRows          Int                         @default(0)
  legalUnmatchedRows        Int                         @default(0)
  legalAmbiguousRows        Int                         @default(0)
  legalWarningRows          Int                         @default(0)
  legalErrorRows            Int                         @default(0)
  uploadedById              String                      @db.Uuid
  uploadedBy                User                        @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  confirmedById             String?                     @db.Uuid
  confirmedBy               User?                       @relation("ImportConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  rolledBackById            String?                     @db.Uuid
  rolledBackBy              User?                       @relation("ImportRolledBackBy", fields: [rolledBackById], references: [id], onDelete: SetNull)
  rows                      ProjectImportRow[]
  supplementalRows          SupplementalCollectionRow[]
  legalRows                 LegalMatterRow[]
  risks                     Risk[]
  riskTimelineEvents        RiskTimelineEvent[]
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(3)
  confirmedAt               DateTime?                   @db.Timestamptz(3)
  rolledBackAt              DateTime?                   @db.Timestamptz(3)

  @@index([fileHash])
  @@index([status, createdAt])
  @@index([uploadedById])
  @@map("import_batches")
}

model ProjectImportRow {
  id                    String           @id @default(uuid()) @db.Uuid
  batchId               String           @db.Uuid
  batch                 ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber             Int
  importKey             String           @db.VarChar(64)
  action                ImportRowAction
  status                ImportRowStatus
  externalCode          String?          @db.VarChar(128)
  projectName           String?          @db.VarChar(255)
  departmentName        String?          @db.VarChar(128)
  deliveryOwnerName     String?          @db.VarChar(128)
  annualPlanAmount      Decimal?         @db.Decimal(18, 2)
  actualCollectedAmount Decimal?         @db.Decimal(18, 2)
  remainingAmount       Decimal?         @db.Decimal(18, 2)
  monthlyCollections    Json?
  monthAttributes       Json?
  collectionRiskLevel   ProjectRiskLevel @default(UNKNOWN)
  collectionProgress    String?          @db.Text
  sourceSnapshot        Json
  warnings              Json?
  errors                Json?
  matchedProjectId      String?          @db.Uuid
  matchedProject        Project?         @relation("MatchedImportProject", fields: [matchedProjectId], references: [id], onDelete: SetNull)
  committedProjectId    String?          @db.Uuid
  committedProject      Project?         @relation("CommittedImportProject", fields: [committedProjectId], references: [id], onDelete: SetNull)
  beforeSnapshot        Json?
  afterSnapshot         Json?
  committedRiskId       String?          @db.Uuid
  beforeRiskSnapshot    Json?
  afterRiskSnapshot     Json?
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([importKey])
  @@index([matchedProjectId])
  @@index([committedProjectId])
  @@map("project_import_rows")
}

model SupplementalCollectionRow {
  id                         String                  @id @default(uuid()) @db.Uuid
  batchId                    String                  @db.Uuid
  batch                      ImportBatch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber                  Int
  sourceSheet                String                  @default("涵谷回款") @db.VarChar(128)
  sourceKey                  String                  @db.VarChar(64)
  status                     ImportRowStatus
  matchStatus                SupplementalMatchStatus
  matchedImportKey           String?                 @db.VarChar(64)
  projectId                  String?                 @db.Uuid
  project                    Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  externalCode               String?                 @db.VarChar(128)
  projectName                String?                 @db.VarChar(500)
  contractReceivableAmount   Decimal?                @db.Decimal(18, 2)
  procurementContractAmount  Decimal?                @db.Decimal(18, 2)
  cumulativeCollectedAmount  Decimal?                @db.Decimal(18, 2)
  remainingUncollectedAmount Decimal?                @db.Decimal(18, 2)
  actualCollectedThisYear    Decimal?                @db.Decimal(18, 2)
  actualCollectedNetThisYear Decimal?                @db.Decimal(18, 2)
  annualCollectionPlan       Decimal?                @db.Decimal(18, 2)
  collectionRiskLevel        ProjectRiskLevel        @default(UNKNOWN)
  monthlyCollections         Json?
  monthAttributes            Json?
  afterYearAmount            Decimal?                @db.Decimal(18, 2)
  sourceSnapshot             Json
  warnings                   Json?
  errors                     Json?
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([matchStatus])
  @@index([projectId])
  @@index([sourceKey])
  @@map("supplemental_collection_rows")
}

model LegalMatterRow {
  id                  String                 @id @default(uuid()) @db.Uuid
  batchId             String                 @db.Uuid
  batch               ImportBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber           Int
  sourceSheet         String                 @default("发函-诉讼清单") @db.VarChar(128)
  sourceKey           String                 @db.VarChar(64)
  status              ImportRowStatus
  matchStatus         LegalMatterMatchStatus
  matchedImportKey    String?                @db.VarChar(64)
  projectId           String?                @db.Uuid
  project             Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  externalCode        String?                @db.VarChar(128)
  projectName         String?                @db.VarChar(500)
  departmentName      String?                @db.VarChar(128)
  deliveryOwnerName   String?                @db.VarChar(128)
  annualPlanAmount    Decimal?               @db.Decimal(18, 2)
  collectionRiskLevel ProjectRiskLevel       @default(UNKNOWN)
  legalProgress       String?                @db.Text
  monthlyCollections  Json?
  monthAttributes     Json?
  sourceSnapshot      Json
  warnings            Json?
  errors              Json?
  committedRiskId     String?                @db.Uuid
  beforeRiskSnapshot  Json?
  afterRiskSnapshot   Json?
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([matchStatus])
  @@index([projectId])
  @@index([sourceKey])
  @@map("legal_matter_rows")
}

model RiskCategory {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(64)
  name               String              @db.VarChar(128)
  keywords           Json?
  colorToken         String              @default("#4C8FE8") @db.VarChar(16)
  description        String?             @db.VarChar(500)
  defaultLevel       ProjectRiskLevel?
  sortOrder          Int                 @default(0)
  isActive           Boolean             @default(true)
  risks              Risk[]
  mailRiskCandidates MailRiskCandidate[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("risk_categories")
}

model RiskLevelRule {
  id          String           @id @default(uuid()) @db.Uuid
  level       ProjectRiskLevel @unique
  displayName String           @db.VarChar(32)
  colorToken  String           @db.VarChar(16)
  criteria    String           @db.VarChar(500)
  keywords    Json?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("risk_level_rules")
}

model ProjectAlias {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alias           String    @db.VarChar(255)
  normalizedAlias String    @unique @db.VarChar(255)
  source          String    @default("系统管理员") @db.VarChar(64)
  note            String?   @db.VarChar(500)
  isActive        Boolean   @default(true)
  hitCount        Int       @default(0)
  lastHitAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([projectId, isActive])
  @@map("project_aliases")
}

model SystemConfigRelease {
  id             String   @id @default(uuid()) @db.Uuid
  version        String   @unique @db.VarChar(32)
  module         String   @default("ALL") @db.VarChar(32)
  changeCount    Int
  changeSummary  String   @db.VarChar(500)
  impactScope    Json
  beforeSnapshot Json?
  snapshot       Json
  publishedById  String?  @db.Uuid
  publishedBy    User?    @relation("SystemConfigPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  traceId        String   @unique @db.VarChar(64)
  publishedAt    DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([publishedAt])
  @@index([module, publishedAt])
  @@map("system_config_releases")
}

model Risk {
  id                     String              @id @default(uuid()) @db.Uuid
  projectId              String              @db.Uuid
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId             String              @db.Uuid
  category               RiskCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                  String              @db.VarChar(250)
  description            String              @db.Text
  evidence               String?             @db.Text
  level                  ProjectRiskLevel
  status                 RiskStatus          @default(ACTIVE)
  sourceType             RiskSourceType
  sourceBatchId          String?             @db.Uuid
  sourceBatch            ImportBatch?        @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  sourceRefId            String?             @db.Uuid
  reporterUserId         String?             @db.Uuid
  reporterUser           User?               @relation("RiskReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reporterNameSource     String?             @db.VarChar(100)
  weekCode               String?             @db.VarChar(20)
  suggestion             String?             @db.Text
  detectedAt             DateTime            @default(now()) @db.Timestamptz(3)
  resolvedAt             DateTime?           @db.Timestamptz(3)
  resolvedById           String?             @db.Uuid
  resolvedBy             User?               @relation("RiskResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionReason       String?             @db.Text
  dedupeFingerprint      String              @unique @db.VarChar(64)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  actionItem             ActionItem?
  timelineEvents         RiskTimelineEvent[]
  confirmedMailCandidate MailRiskCandidate?  @relation("ConfirmedMailRisk")

  @@index([projectId, status])
  @@index([categoryId, status])
  @@index([level, status])
  @@index([sourceBatchId])
  @@index([detectedAt])
  @@map("risks")
}

model ActionItem {
  id                 String               @id @default(uuid()) @db.Uuid
  riskId             String?              @db.Uuid
  risk               Risk?                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  projectId          String               @db.Uuid
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String               @db.VarChar(250)
  description        String               @db.Text
  urgency            ActionItemUrgency
  status             ActionItemStatus     @default(PENDING)
  sourceType         ActionItemSourceType @default(RISK_SUGGESTION)
  assigneeUserId     String?              @db.Uuid
  assigneeUser       User?                @relation("ActionAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeNameSource String?              @db.VarChar(128)
  dueDate            DateTime?            @db.Date
  completionNote     String?              @db.Text
  createdById        String?              @db.Uuid
  createdBy          User?                @relation("ActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedById      String?              @db.Uuid
  completedBy        User?                @relation("ActionCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt        DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  timelineEvents     RiskTimelineEvent[]

  @@unique([riskId])
  @@index([projectId, status])
  @@index([assigneeUserId, status])
  @@index([assigneeNameSource, status])
  @@index([urgency, status])
  @@index([dueDate])
  @@map("action_items")
}

model RiskTimelineEvent {
  id              String                @id @default(uuid()) @db.Uuid
  projectId       String                @db.Uuid
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  riskId          String                @db.Uuid
  risk            Risk                  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  actionItemId    String?               @db.Uuid
  actionItem      ActionItem?           @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  eventType       RiskTimelineEventType
  title           String                @db.VarChar(250)
  description     String                @db.Text
  fromValue       String?               @db.VarChar(128)
  toValue         String?               @db.VarChar(128)
  actorUserId     String?               @db.Uuid
  actor           User?                 @relation("RiskTimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorNameSource String?               @db.VarChar(128)
  sourceBatchId   String?               @db.Uuid
  sourceBatch     ImportBatch?          @relation(fields: [sourceBatchId], references: [id], onDelete: Cascade)
  occurredAt      DateTime              @default(now()) @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)

  @@index([projectId, occurredAt])
  @@index([riskId, occurredAt])
  @@index([actionItemId])
  @@index([eventType, occurredAt])
  @@index([sourceBatchId])
  @@map("risk_timeline_events")
}

model AiProviderConfig {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique @db.VarChar(128)
  vendor            String             @db.VarChar(128)
  endpoint          String             @db.VarChar(500)
  model             String             @db.VarChar(128)
  encryptedApiKey   String             @db.Text
  keyIv             String             @db.VarChar(64)
  keyAuthTag        String             @db.VarChar(64)
  keyLast4          String             @db.VarChar(16)
  expiresAt         DateTime?          @db.Date
  timeoutSeconds    Int                @default(60)
  retryCount        Int                @default(2)
  enabled           Boolean            @default(true)
  isDefault         Boolean            @default(false)
  priority          Int                @default(100)
  lastTestStatus    AiConnectionStatus @default(UNTESTED)
  lastTestAt        DateTime?          @db.Timestamptz(3)
  lastTestLatencyMs Int?
  lastTestErrorCode String?            @db.VarChar(128)
  createdById       String?            @db.Uuid
  createdBy         User?              @relation("AiProviderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?            @db.Uuid
  updatedBy         User?              @relation("AiProviderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  callLogs          AiCallLog[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@index([enabled, isDefault])
  @@index([lastTestStatus, lastTestAt])
  @@index([expiresAt])
  @@map("ai_provider_configs")
}

model AiCallLog {
  id                   String            @id @default(uuid()) @db.Uuid
  traceId              String            @unique @db.VarChar(64)
  providerId           String?           @db.Uuid
  provider             AiProviderConfig? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerNameSnapshot String            @db.VarChar(128)
  modelSnapshot        String            @db.VarChar(128)
  scene                AiCallScene
  inputTokens          Int               @default(0)
  outputTokens         Int               @default(0)
  totalTokens          Int               @default(0)
  durationMs           Int
  result               AiCallResult
  errorCode            String?           @db.VarChar(128)
  errorSummary         String?           @db.VarChar(500)
  actorUserId          String?           @db.Uuid
  actor                User?             @relation("AiCallActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)

  @@index([providerId, createdAt])
  @@index([scene, createdAt])
  @@index([result, createdAt])
  @@index([actorUserId, createdAt])
  @@map("ai_call_logs")
}

model UserProjectScope {
  projectId   String             @db.Uuid
  userId      String             @db.Uuid
  assignedBy  String?            @db.Uuid
  scopeSource ProjectScopeSource @default(ADMIN)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User               @relation("ScopedUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner    User?              @relation("ScopeGrantedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  assignedAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@id([projectId, userId])
  @@index([userId])
  @@index([assignedBy])
  @@map("user_project_scopes")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @db.VarChar(255)
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  clientIpHash String?   @db.VarChar(128)
  userAgent    String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  actorUserId    String?     @db.Uuid
  actor          User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  module         String      @db.VarChar(64)
  action         String      @db.VarChar(128)
  resourceType   String      @db.VarChar(128)
  resourceId     String?     @db.VarChar(128)
  result         AuditResult
  traceId        String      @db.VarChar(64)
  clientIp       String?     @db.VarChar(64)
  userAgent      String?     @db.VarChar(500)
  beforeSnapshot Json?
  afterSnapshot  Json?
  errorCode      String?     @db.VarChar(128)
  summary        String?     @db.VarChar(500)
  isSensitive    Boolean     @default(false)
  previousHash   String?     @db.VarChar(64)
  integrityHash  String?     @db.VarChar(64)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorUserId])
  @@index([module, action])
  @@index([resourceType, resourceId])
  @@index([traceId])
  @@index([createdAt])
  @@index([isSensitive, createdAt])
  @@map("audit_logs")
}

model MailboxConfig {
  id                         String                  @id @default(uuid()) @db.Uuid
  userId                     String                  @unique @db.Uuid
  user                       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                   MailboxProvider
  email                      String                  @db.VarChar(255)
  imapHost                   String                  @db.VarChar(255)
  imapPort                   Int
  encryption                 MailboxEncryption
  folder                     String                  @default("INBOX") @db.VarChar(255)
  encryptedAuthCode          String                  @db.Text
  authCodeIv                 String                  @db.VarChar(64)
  authCodeTag                String                  @db.VarChar(64)
  authCodeLast4              String                  @db.VarChar(16)
  subjectKeywords            Json
  senderRule                 String?                 @db.VarChar(255)
  initialSyncWeeks           Int                     @default(4)
  readAttachments            Boolean                 @default(true)
  aiExtractionEnabled        Boolean                 @default(true)
  enabled                    Boolean                 @default(true)
  autoSyncEnabled            Boolean                 @default(true)
  uidCursor                  BigInt?
  connectionStatus           MailboxConnectionStatus @default(UNTESTED)
  lastTestAt                 DateTime?               @db.Timestamptz(3)
  lastTestLatencyMs          Int?
  lastTestErrorCode          String?                 @db.VarChar(128)
  lastTestErrorSummary       String?                 @db.VarChar(500)
  lastSyncAt                 DateTime?               @db.Timestamptz(3)
  lastSyncStatus             MailSyncStatus?
  lastSyncNewCount           Int                     @default(0)
  lastSyncSuccessCount       Int                     @default(0)
  lastSyncRiskCandidateCount Int                     @default(0)
  lastSyncFailedCount        Int                     @default(0)
  syncBatches                MailSyncBatch[]
  messages                   MailMessage[]
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)

  @@index([enabled, autoSyncEnabled])
  @@index([connectionStatus])
  @@map("mailbox_configs")
}

model MailSyncBatch {
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(64)
  mailboxConfigId    String          @db.Uuid
  mailboxConfig      MailboxConfig   @relation(fields: [mailboxConfigId], references: [id], onDelete: Cascade)
  trigger            MailSyncTrigger
  status             MailSyncStatus  @default(QUEUED)
  operatorUserId     String?         @db.Uuid
  operator           User?           @relation("MailSyncOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  startedAt          DateTime?       @db.Timestamptz(3)
  finishedAt         DateTime?       @db.Timestamptz(3)
  durationMs         Int?
  scannedCount       Int             @default(0)
  newCount           Int             @default(0)
  successCount       Int             @default(0)
  skippedCount       Int             @default(0)
  failedCount        Int             @default(0)
  riskCandidateCount Int             @default(0)
  startUid           BigInt?
  endUid             BigInt?
  errorSummary       String?         @db.VarChar(500)
  retryOfId          String?         @db.Uuid
  retryOf            MailSyncBatch?  @relation("MailSyncRetry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries            MailSyncBatch[] @relation("MailSyncRetry")
  targetMessageId    String?         @db.Uuid
  targetMessage      MailMessage?    @relation("MailRetryTarget", fields: [targetMessageId], references: [id], onDelete: SetNull)
  messages           MailMessage[]
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  @@index([mailboxConfigId, createdAt])
  @@index([status, createdAt])
  @@index([operatorUserId])
  @@index([retryOfId])
  @@index([targetMessageId])
  @@map("mail_sync_batches")
}

model MailMessage {
  id                 String                    @id @default(uuid()) @db.Uuid
  mailboxConfigId    String                    @db.Uuid
  mailboxConfig      MailboxConfig             @relation(fields: [mailboxConfigId], references: [id], onDelete: Cascade)
  batchId            String                    @db.Uuid
  batch              MailSyncBatch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  messageId          String                    @db.VarChar(500)
  imapUid            BigInt
  subject            String                    @db.VarChar(500)
  senderName         String?                   @db.VarChar(255)
  senderAddress      String?                   @db.VarChar(255)
  sentAt             DateTime?                 @db.Timestamptz(3)
  processedAt        DateTime?                 @db.Timestamptz(3)
  status             MailMessageStatus         @default(ANALYZING)
  skipReason         MailMessageSkipReason?
  failureCode        String?                   @db.VarChar(128)
  failureSummary     String?                   @db.VarChar(500)
  sanitizedSummary   String?                   @db.Text
  keyPoints          Json?
  attachmentMetadata Json?
  processingTrace    Json?
  retryCount         Int                       @default(0)
  projectMatches     MailMessageProjectMatch[]
  riskCandidates     MailRiskCandidate[]
  retryBatches       MailSyncBatch[]       @relation("MailRetryTarget")
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([mailboxConfigId, messageId])
  @@unique([mailboxConfigId, imapUid])
  @@index([batchId, status])
  @@index([mailboxConfigId, sentAt])
  @@index([status, updatedAt])
  @@map("mail_messages")
}

model MailMessageProjectMatch {
  id            String               @id @default(uuid()) @db.Uuid
  messageId     String               @db.Uuid
  message       MailMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  projectId     String               @db.Uuid
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matchType     MailProjectMatchType
  confidence    Int
  matchedText   String               @db.VarChar(500)
  confirmedById String?              @db.Uuid
  confirmedBy   User?                @relation("MailMatchConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([messageId, projectId])
  @@index([projectId, createdAt])
  @@index([confirmedById])
  @@map("mail_message_project_matches")
}

model MailRiskCandidate {
  id              String                  @id @default(uuid()) @db.Uuid
  messageId       String                  @db.Uuid
  message         MailMessage             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  projectId       String                  @db.Uuid
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId      String                  @db.Uuid
  category        RiskCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  level           ProjectRiskLevel
  description     String                  @db.Text
  evidence        String                  @db.Text
  suggestion      String                  @db.Text
  confidence      Int
  status          MailRiskCandidateStatus @default(PENDING)
  confirmedRiskId String?                 @unique @db.Uuid
  confirmedRisk   Risk?                   @relation("ConfirmedMailRisk", fields: [confirmedRiskId], references: [id], onDelete: SetNull)
  reviewedById    String?                 @db.Uuid
  reviewedBy      User?                   @relation("MailRiskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?               @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)

  @@index([messageId, status])
  @@index([projectId, status])
  @@index([categoryId, status])
  @@index([reviewedById])
  @@map("mail_risk_candidates")
}
