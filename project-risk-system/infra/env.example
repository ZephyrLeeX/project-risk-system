# Production deployment environment template (T035).
# Copy to .env.production (gitignored), fill real values, then:
#   docker compose --env-file .env.production -f infra/docker-compose.yml up -d
#
# All values below are placeholders. Never commit real secrets. Generate real
# values with infra/scripts/init-secrets.sh (session key) and openssl (TLS cert);
# see infra/README.md.

# --- Runtime / edge ---
NODE_ENV=production
# Public origin the browser uses to reach the app (proxy TLS port).
CORS_ORIGIN=https://risk.example.internal:8443
# Host port for the HTTPS reverse proxy.
PROXY_HTTPS_PORT=8443
# Celery worker concurrency on the single server.
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=900
LOG_LEVEL=info
SESSION_COOKIE_NAME=project_risk_session

# --- PostgreSQL (16) ---
POSTGRES_DB=project_risk
POSTGRES_USER=project_risk
# URL-safe (base64url); generated by init-secrets.sh. Required.
POSTGRES_PASSWORD=replace_with_url_safe_password
# Optional localhost-only host bind for local dev / operator psql. Leave UNSET
# in production: the stack reaches postgres over the compose network only and
# publishes no host 5432, so a host process using 5432 cannot block the deploy.
# Setting a host port (e.g. 5432) takes effect only when the
# infra/docker-compose.host-postgres.yml override is also in COMPOSE_FILE (see
# `pnpm db:up`); it is independent of the fixed in-container 5432 and never
# reuses POSTGRES_PORT for the host bind.
#POSTGRES_HOST_PORT=5432

# --- Secrets (injected, never committed) ---
# 32-byte base64 key for at-rest field encryption. Required; generate one:
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# Session signing key is mounted as a read-only compose secret at
# /run/secrets/project_risk_session_key (generated by init-secrets.sh); no env
# var is needed here.

# --- Scheduler cadence (ADR 0030 operational defaults; not SLOs) ---
SCHEDULER_OUTBOX_DRAIN_INTERVAL_SECONDS=5
SCHEDULER_RECONCILE_INTERVAL_SECONDS=30
SCHEDULER_MAILBOX_SYNC_INTERVAL_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=1
SCHEDULER_LOG_LEVEL=INFO

# --- Initial admin (used only by `risk-platform-seed` during first init) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=replace_with_strong_password
